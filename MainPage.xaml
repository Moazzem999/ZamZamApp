<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZamZamApp.MainPage"
    Title="My First App">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="Welcome to My App!"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Built with C# and .NET MAUI"
                FontSize="16"
                HorizontalOptions="Center" />

            <Entry
                x:Name="NameEntry"
                Placeholder="Enter your name" />

            <Button
                Text="Say Hello"
                Clicked="OnSayHelloClicked" />

            <Label
                x:Name="MessageLabel"
                FontSize="18"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
