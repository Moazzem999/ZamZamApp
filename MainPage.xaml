<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZamZamApp.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,24,20,36"
            Spacing="20"
            MaximumWidthRequest="540"
            HorizontalOptions="Center">

            <!-- 1. Header Section -->
            <Border
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                StrokeShape="RoundRectangle 20"
                Padding="20,18">
                <Border.Shadow>
                    <Shadow Brush="#15000000" Offset="0,4" Radius="12" Opacity="0.8" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                    <!-- Brand Icon Badge with Official Logo -->
                    <Border
                        Grid.Column="0"
                        WidthRequest="54"
                        HeightRequest="54"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBgDark}}"
                        Padding="3">
                        <Image
                            Source="zamzam_logo.png"
                            Aspect="AspectFit"
                            WidthRequest="48"
                            HeightRequest="48"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Title & Subtitle -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                Text="ZamZam Tracker"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />

                            <!-- Status Pill Badge -->
                            <Border
                                Grid.Column="1"
                                x:Name="StatusBadgeBorder"
                                StrokeThickness="1"
                                Stroke="{StaticResource WarningAmber}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningAmberBg}, Dark={StaticResource Gray900}}"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,4">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Ellipse
                                        x:Name="StatusBadgeDot"
                                        WidthRequest="7"
                                        HeightRequest="7"
                                        Fill="{StaticResource WarningAmber}"
                                        VerticalOptions="Center" />
                                    <Label
                                        x:Name="StatusBadgeText"
                                        Text="Setup Required"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource WarningAmber}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Label
                            Text="Autonomous Background Telemetry Service"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- 2. Live Telemetry & Metrics Card -->
            <Border
                x:Name="TelemetryDashboardCard"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}">
                <Border.Shadow>
                    <Shadow Brush="#10000000" Offset="0,4" Radius="10" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Metrics Header -->
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📊" FontSize="16" VerticalOptions="Center" />
                        <Label
                            Text="Live System Telemetry"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Stat Metric Tiles -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <!-- Stat 1: Battery -->
                        <Border
                            Grid.Column="0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="🔋 Battery" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalOptions="Center" />
                                <Label x:Name="BatteryValueLabel" Text="--%" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource SuccessGreen}" HorizontalOptions="Center" />
                                <Label Text="Monitored" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Stat 2: Interval -->
                        <Border
                            Grid.Column="1"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="⏱️ Interval" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalOptions="Center" />
                                <Label x:Name="IntervalValueLabel" Text="-- min" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
                                <Label x:Name="IntervalSubLabel" Text="Sync cycle" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Stat 3: Employee -->
                        <Border
                            Grid.Column="2"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 12"
                            Padding="10,12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="👤 Employee" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" HorizontalOptions="Center" />
                                <Label x:Name="EmployeeIdValueLabel" Text="None" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" HorizontalOptions="Center" />
                                <Label Text="ID Assigned" FontSize="9" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Live GPS & Transmission Details Box -->
                    <Border
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                x:Name="CoordinatesLabel"
                                Text="🌐 Location: Standby / Awaiting GPS Fix"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            <Label
                                x:Name="LastSyncLabel"
                                Text="🕒 Last Sync: Waiting for initial cycle"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Configuration Form Card -->
            <Border
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                Padding="22"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}">
                <Border.Shadow>
                    <Shadow Brush="#10000000" Offset="0,4" Radius="10" Opacity="0.6" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <!-- Section Title & Subtitle -->
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Configuration Settings"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
                        <Label
                            Text="One-time setup locked for lifetime. Reinstallation required to modify."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>

                    <!-- Employee ID Field -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="👤" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="Employee ID"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <Border
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Padding="14,2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <Entry
                                x:Name="EmployeeIdEntry"
                                Placeholder="e.g. 1001"
                                Keyboard="Numeric"
                                TextChanged="OnNumericEntryTextChanged"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Label
                            Text="Numeric ID used to associate tracking data with employee records."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- Date of Birth Field -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📅" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="Date of Birth"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <Border
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Padding="14,2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <Entry
                                x:Name="DateOfBirthEntry"
                                Placeholder="YYYY-MM-DD (e.g. 1995-08-25)"
                                Keyboard="Text"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Label
                            Text="Employee date of birth formatted as YYYY-MM-DD."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- Mobile Number Field -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📱" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="Mobile Number"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <Border
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Padding="14,2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <Entry
                                x:Name="MobileEntry"
                                Placeholder="e.g. 01712345678"
                                Keyboard="Telephone"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Label
                            Text="Primary mobile contact number used for identification."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- API Trigger Duration Field -->
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🕒" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="API Trigger Duration"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        
                        <!-- Start Time -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Start Time"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            <Border
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="8,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                                <TimePicker
                                    x:Name="StartTimePicker"
                                    Format="hh:mm tt"
                                    Time="10:30:00"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- End Time -->
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="End Time"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            <Border
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Padding="8,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                                <TimePicker
                                    x:Name="EndTimePicker"
                                    Format="hh:mm tt"
                                    Time="18:30:00"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            </Border>
                        </VerticalStackLayout>

                        <Label
                            Text="The system only triggers the API within this daily time period (e.g. 10:30 AM to 6:30 PM)."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- API Trigger Interval Field -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="⏱️" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="API Trigger Interval (minutes)"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <Border
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Padding="14,2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <Entry
                                x:Name="ApiIntervalEntry"
                                Placeholder="e.g. 15"
                                Keyboard="Numeric"
                                TextChanged="OnNumericEntryTextChanged"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Label
                            Text="Frequency of background GPS collection and API transmission in minutes."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- API URL Field -->
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="🔗" FontSize="13" VerticalOptions="Center" />
                            <Label
                                Text="API Endpoint URL"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <Border
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Padding="14,2"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                            <Entry
                                x:Name="ApiUrlEntry"
                                Placeholder="https://api.example.com/v1/sync"
                                Keyboard="Url"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>
                        <Label
                            Text="Target HTTP POST endpoint receiving telemetry payload."
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                    </VerticalStackLayout>

                    <!-- Status Notification Label -->
                    <Label
                        x:Name="StatusMessageLabel"
                        FontSize="12"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="False" />

                    <!-- Save / Activate Button -->
                    <Button
                        x:Name="SaveSettingsButton"
                        Text="🔒 Save &amp; Activate Tracker"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource BrandPrimary}"
                        TextColor="{StaticResource White}"
                        Clicked="OnSaveClicked"
                        Margin="0,8,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#304F46E5" Offset="0,4" Radius="8" Opacity="0.8" />
                        </Button.Shadow>
                    </Button>

                    <!-- Debug Reset Button (Visible only during Visual Studio test runs) -->
                    <Button
                        x:Name="DebugResetButton"
                        Text="⚠️ Reset Settings (Debug Only)"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                        BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        BorderWidth="1"
                        HeightRequest="36"
                        CornerRadius="8"
                        Clicked="OnDebugResetClicked"
                        IsVisible="False"
                        Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- 4. Live Activity / Event Console Card -->
            <Border
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 14"
                Padding="16,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="💻" FontSize="13" VerticalOptions="Center" />
                        <Label
                            Text="System Activity Log"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}">
                        <Label
                            x:Name="ConsoleLogLabel"
                            Text="System standby. Awaiting configuration activation."
                            FontSize="11"
                            FontFamily="Consolas"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                            LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
